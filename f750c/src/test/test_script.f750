.data:
    const SomeNumber: dword 42
    const SomeString: "Hello, World!", 0
    const LoopString: "Loop!", 0
    foo: dword -67
    bar: float 69.420

_start:
    mov a32, 1
    mov b32, #SomeNumber
    add c32, 5
    mov d32, &foo
    mov &foo, a32

    mov a64, #EngCall.Character.Random.FloatRange
    push float -0.5
    push float 0.5
    engcall

    mov &bar, a64
    @if a64, float 0.0, jns
        @if a64, float 0.25, js
            mov a64, #EngCall.Debug.Log
            push #SomeString
            engcall
        @fi
    @fi

    @inline_loop 10
        mov a64, #EngCall.Debug.Log
        push #LoopString
        engcall
    @endloop