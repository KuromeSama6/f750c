.data:
    const SomeNumber: dword 42
    const SomeString: "Hello, World!", 0
    const LoopString: "Loop!", 0
    const DangerousConstant: dword 0xffffffff
    foo: dword -67
    bar: float 69.420
    magic: word 0x55aa
    const Arg0: byte 0xff
    const Arg1: byte 0xf0

_start:
    stackalloc 32

    mov a32, 1
    mov b32, &const SomeNumber
    add c32, 5
    mov d32, &foo
    mov &foo, a32
    mov a64, _start

    mov &sp64, magic

    mov a64, #EngCall.Character.Random.FloatRange
    push float -0.5
    push float 0.5
    engcall

    mov &bar, a64

    @pry DangerousConstant, &const SomeNumber

    push &const Arg0
    push &const Arg1
    call _proc

    stackfree

_proc:
    stackalloc 2
    @getarg a8, 0
    mov &sp8, a8 ; arg1
    @getarg b8, 1
    mov &sp8+1, b8 ; arg0

    @engcall #SomeEngineCall, &const DangerousConstant, b8

    stackfree
    ret