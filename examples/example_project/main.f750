.data:
    const SomeNumber: dword 42
    const SomeString: "Hello, World!", 0
    const LoopString: "Loop!", 0
    const DangerousConstant: dword 0xffffffff
    foo: dword -67
    bar: float 69.420
    magic: word 0x55aa
    const Arg0: byte 0xff
    const Arg1: byte 0xf0

_start:
    stackalloc 32

    mov a32, &const SomeNumber
    mov a32, &SomeString
    mov a32, &LoopString
    mov a32, &DangerousConstant
    mov a32, &foo
    mov a32, &bar
    mov a32, &magic
    mov a32, &const Arg0
    mov a32, &const Arg1

    mov a32, 1
    mov b32, &const SomeNumber
    add c32, 5
    mov d32, &foo
    mov &foo, a32
    mov &SomeString, 5
    mov a64, _extern some_module::some_proc + 32

    mov &sp64, magic
    mov &d64, &extern some_module::SomeNumber + 64

    mov a64, #EngCall.Character.Random.FloatRange
    push float -0.5
    push float 0.5
    engcall

    mov &bar, a64

    @pry DangerousConstant, &const SomeNumber

    @if a64, 1, je
        mov b64, 1
    @elseif a64, 2, je
        mov b64, 2
    @elseif a64, 3, je
        mov b64, 3
    @else
        mov b64, 0
    @end

    @if b64, &const SomeNumber, je
        mov a64, 50
        mov b64, &foo
        @engcall #SomeEngineCall, &const SomeNumber, b8

        @if b64, &const SomeNumber, je
            mov a64, 50
            mov b64, &foo
            @engcall #SomeEngineCall, &const SomeNumber, b8
        @end

    @elseif c64, &const SomeNumber, je
        mov a64, 100
        mov b64, &foo
        @engcall #SomeEngineCall, &const SomeNumber, b8
    @elseif d64, &const SomeNumber, je
        mov a64, 150
        mov b64, &foo
        @engcall #SomeEngineCall, &const SomeNumber, b8
    @else
        mov a64, 200
        mov b64, &foo
        @engcall #SomeEngineCall, &const SomeNumber, b8
    @end

    push &const Arg0
    push &const Arg1
    call _proc

    stackfree

_proc:
    stackalloc 2
    @getarg a8, 0
    mov &sp8, a8 ; arg1
    @getarg b8, 1
    mov &sp8+1, b8 ; arg0

    stackfree
    ret